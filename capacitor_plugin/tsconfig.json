{
    "compilerOptions": {
        "allowUnreachableCode": false,
        "declaration": true,
        "esModuleInterop": true,
        "inlineSources": false,
        "lib": [
            "ES2024",
            "DOM"
        ],
        "module": "esnext",
        "types": [
            "node"
        ],
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "outDir": "dist/esm",
        "rootDir": "./src",
        "pretty": true,
        "sourceMap": false,
        "strict": true,
        "target": "ES2024"
    },
    "files": [
        "src/index.ts"
    ]
}